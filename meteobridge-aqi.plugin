#!/bin/sh
# Meteobridge AQI add-on
# User-Defined Station plugin. Reads a PurpleAir sensor directly over the LAN,
# calculates EPA 2024 AQI/NowCast, and emits Meteobridge plugin sensor records.
# POSIX sh + awk; no Python dependency.

set -u

VERSION="2.0.0"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)
: "${PURPLEAIR_URL:=}" "${PM25_SOURCE:=atm}"
: "${MAX_SENSOR_AGE:=300}" "${HTTP_TIMEOUT:=10}"
: "${AQI_STANDARD:=EPA_2024}" "${AQI_MODE:=both}" "${AQI_CAP:=500}"
: "${CATEGORY_SOURCE:=nowcast}" "${PURPLEAIR_CORRECTION:=none}"
: "${CORRECTION_MISSING_RH:=reject}" "${NOWCAST_ENABLED:=yes}"
: "${NOWCAST_HOURS:=12}" "${NOWCAST_MIN_RECENT:=2}"
: "${NOWCAST_REQUIRE_CURRENT:=no}" "${MIN_HOURLY_COVERAGE:=75}"
: "${OUTPUT_INSTANT_AQI:=data0}" "${OUTPUT_NOWCAST_AQI:=data1}"
: "${OUTPUT_CATEGORY:=data2}" "${OUTPUT_PM25:=data3}"
: "${OUTPUT_NOWCAST_PM25:=data4}" "${OUTPUT_STATUS:=data5}"
: "${UPDATE_SECONDS:=120}"
: "${LOG_LEVEL:=info}" "${STATE_DIR:=}"
: "${LOG_MAX_KB:=256}"

CONFIG_FOUND=no
CONFIG_FILE=""
if [ "${METEOBRIDGE_AQI_CONFIG+x}" = x ]; then
    CONFIG_FILE=$METEOBRIDGE_AQI_CONFIG
    [ -r "$CONFIG_FILE" ] && CONFIG_FOUND=yes
else
    for candidate in \
        "$SCRIPT_DIR/meteobridge-aqi.conf" \
        "${METEOBRIDGE_SCRIPTS_DIR:-/temp/data/scripts}/meteobridge-aqi.conf" \
        "/temp/data/scripts/meteobridge-aqi.conf" \
        "/tmp/data/scripts/meteobridge-aqi.conf" \
        "/tmp/mnt/data/scripts/meteobridge-aqi.conf" \
        "/data/scripts/meteobridge-aqi.conf" \
        "/scripts/meteobridge-aqi.conf"
    do
        if [ -r "$candidate" ]; then
            CONFIG_FILE=$candidate
            CONFIG_FOUND=yes
            break
        fi
    done
fi

if [ "$CONFIG_FOUND" = yes ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
    CONFIG_DIR=$(CDPATH= cd -- "$(dirname -- "$CONFIG_FILE")" 2>/dev/null && pwd)
fi

if [ -z "$STATE_DIR" ]; then
    if [ "$CONFIG_FOUND" = yes ]; then
        STATE_DIR="$CONFIG_DIR/meteobridge-aqi-state"
    else
        STATE_DIR="${TMPDIR:-/tmp}/meteobridge-aqi-state"
    fi
fi

HISTORY_FILE="$STATE_DIR/pm25-history.tsv"
STATUS_FILE="$STATE_DIR/status.txt"
OUTPUT_FILE="$STATE_DIR/last-output.txt"
LOG_FILE="$STATE_DIR/meteobridge-aqi.log"
LOCK_DIR="$STATE_DIR/.lock"
SOURCE_STAMP_FILE="$STATE_DIR/source-stamp.txt"

usage() {
    cat >&2 <<EOF
Usage:
  $0                     Run continuously as a Meteobridge User-Defined Plugin
  $0 --once              Fetch once and emit one plugin update (diagnostic)
  $0 --sample PM25 [RH]  Process a supplied sample (diagnostic/service integration)
  $0 --show-source       Show the configured PurpleAir source
  $0 --status            Show the last human-readable status
  $0 --reset-history     Remove retained NowCast samples
  $0 --version           Show version
EOF
}

is_uint() { case ${1-} in ''|*[!0-9]*) return 1;; *) return 0;; esac; }
is_number() {
    awk -v v="${1-}" 'BEGIN { exit !(v ~ /^[-+]?[0-9]+([.][0-9]+)?$/) }'
}

validate_sensor() {
    case $1 in
        ''|*[!A-Za-z0-9\!]*) return 1 ;;
        *) return 0 ;;
    esac
}

validate_output() {
    case $1 in
        data[0-9]|data[0-9][0-9]) return 0 ;;
        *) return 1 ;;
    esac
}

log_rank() {
    case $1 in error) echo 0;; warn) echo 1;; info) echo 2;; debug) echo 3;; *) echo 2;; esac
}

rotate_log() {
    [ -f "$LOG_FILE" ] || return 0
    size=$(wc -c < "$LOG_FILE" 2>/dev/null || echo 0)
    max=$((LOG_MAX_KB * 1024))
    if [ "$size" -gt "$max" ]; then
        mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null || :
    fi
}

log_msg() {
    level=$1; shift
    [ "$(log_rank "$level")" -le "$(log_rank "$LOG_LEVEL")" ] || return 0
    rotate_log
    printf '%s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date)" "$level" "$*" >> "$LOG_FILE" 2>/dev/null || :
}

fail_config() {
    printf '%s 300\n' "${OUTPUT_STATUS:-data5}"
    echo "meteobridge-aqi: configuration error: $*" >&2
    exit 2
}

validate_config() {
    if [ "$CONFIG_FOUND" = yes ]; then
        case $PURPLEAIR_URL in
            http://*/json|https://*/json) : ;;
            *) fail_config "PURPLEAIR_URL must be a complete http(s) URL ending in /json" ;;
        esac
    fi
    case $PM25_SOURCE in atm|cf1) :;; *) fail_config "PM25_SOURCE must be atm or cf1";; esac
    for n in "$MAX_SENSOR_AGE" "$HTTP_TIMEOUT" "$AQI_CAP" "$NOWCAST_HOURS" \
             "$NOWCAST_MIN_RECENT" "$MIN_HOURLY_COVERAGE" "$UPDATE_SECONDS" "$LOG_MAX_KB"; do
        is_uint "$n" || fail_config "numeric settings must contain non-negative integers"
    done
    [ "$UPDATE_SECONDS" -gt 0 ] || fail_config "UPDATE_SECONDS must be greater than zero"
    [ "$NOWCAST_HOURS" -ge 3 ] && [ "$NOWCAST_HOURS" -le 24 ] || fail_config "NOWCAST_HOURS must be 3 through 24"
    [ "$NOWCAST_MIN_RECENT" -ge 1 ] && [ "$NOWCAST_MIN_RECENT" -le 3 ] || fail_config "NOWCAST_MIN_RECENT must be 1 through 3"
    [ "$MIN_HOURLY_COVERAGE" -ge 1 ] && [ "$MIN_HOURLY_COVERAGE" -le 100 ] || fail_config "MIN_HOURLY_COVERAGE must be 1 through 100"
    [ "$AQI_STANDARD" = "EPA_2024" ] || fail_config "only AQI_STANDARD=EPA_2024 is supported"
    case $AQI_MODE in instant|nowcast|both) :;; *) fail_config "AQI_MODE must be instant, nowcast, or both";; esac
    case $CATEGORY_SOURCE in instant|nowcast) :;; *) fail_config "CATEGORY_SOURCE must be instant or nowcast";; esac
    case $PURPLEAIR_CORRECTION in none|epa_us) :;; *) fail_config "PURPLEAIR_CORRECTION must be none or epa_us";; esac
    case $CORRECTION_MISSING_RH in reject|uncorrected) :;; *) fail_config "CORRECTION_MISSING_RH must be reject or uncorrected";; esac
    case $NOWCAST_ENABLED in yes|no) :;; *) fail_config "NOWCAST_ENABLED must be yes or no";; esac
    case $NOWCAST_REQUIRE_CURRENT in yes|no) :;; *) fail_config "NOWCAST_REQUIRE_CURRENT must be yes or no";; esac
    for o in "$OUTPUT_INSTANT_AQI" "$OUTPUT_NOWCAST_AQI" "$OUTPUT_CATEGORY" "$OUTPUT_PM25" "$OUTPUT_NOWCAST_PM25" "$OUTPUT_STATUS"; do
        validate_output "$o" || fail_config "invalid output sensor: $o"
        output_number=${o#data}
        [ "$output_number" -ge 0 ] && [ "$output_number" -le 99 ] || fail_config "output sensors must be data0 through data99"
    done
    outputs="$OUTPUT_INSTANT_AQI $OUTPUT_NOWCAST_AQI $OUTPUT_CATEGORY $OUTPUT_PM25 $OUTPUT_NOWCAST_PM25 $OUTPUT_STATUS"
    [ "$(printf '%s\n' $outputs | sort -u | wc -l | tr -d ' ')" -eq 6 ] || fail_config "output sensors must be unique"
}

fetch_json() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsS --max-time "$HTTP_TIMEOUT" "$PURPLEAIR_URL"
        return $?
    fi
    if command -v wget >/dev/null 2>&1; then
        wget -q -T "$HTTP_TIMEOUT" -O - "$PURPLEAIR_URL"
        return $?
    fi
    return 127
}

parse_json() {
    awk -v source="$PM25_SOURCE" '
        function number(key, marker, pos, rest) {
            marker="\"" key "\":"
            pos=index($0, marker)
            if (!pos) return "NA"
            rest=substr($0, pos+length(marker))
            sub(/^[ \t]*/, "", rest)
            if (match(rest, /^-?[0-9]+([.][0-9]+)?/))
                return substr(rest, RSTART, RLENGTH)
            return "NA"
        }
        {
            if (source == "cf1") {
                a=number("pm2_5_cf_1")
                b=number("pm2_5_cf_1_b")
            } else {
                a=number("pm2_5_atm")
                b=number("pm2_5_atm_b")
            }
            print a "|" b "|" number("current_humidity") "|" \
                  number("uptime") "|" number("period")
        }
    '
}

apply_correction() {
    pm=$1; rh=$2
    case $PURPLEAIR_CORRECTION in
        none) awk -v p="$pm" 'BEGIN { if (p < 0) p=0; printf "%.4f\n", p }' ;;
        epa_us)
            awk -v p="$pm" -v h="$rh" 'BEGIN {
                if (p <= 343) c=(0.524*p)-(0.0862*h)+5.75;
                else c=(0.46*p)+(0.000393*p*p)+2.9738;
                if (c < 0) c=0;
                printf "%.4f\n", c
            }'
            ;;
    esac
}

aqi_from_pm() {
    awk -v raw="$1" -v cap="$AQI_CAP" 'BEGIN {
        c=int((raw+0.0000001)*10)/10;
        if      (c <= 9.0)   { cl=0.0;   ch=9.0;     il=0;   ih=50 }
        else if (c <= 35.4)  { cl=9.1;   ch=35.4;    il=51;  ih=100 }
        else if (c <= 55.4)  { cl=35.5;  ch=55.4;    il=101; ih=150 }
        else if (c <= 125.4) { cl=55.5;  ch=125.4;   il=151; ih=200 }
        else if (c <= 225.4) { cl=125.5; ch=225.4;   il=201; ih=300 }
        else                 { cl=225.5; ch=325.4;   il=301; ih=500 }
        a=((ih-il)/(ch-cl))*(c-cl)+il;
        a=int(a+0.5);
        if (a < 0) a=0;
        if (a > cap) a=cap;
        print a
    }'
}

category_from_aqi() {
    awk -v a="$1" 'BEGIN {
        if (a <= 50) print 0;
        else if (a <= 100) print 1;
        else if (a <= 150) print 2;
        else if (a <= 200) print 3;
        else if (a <= 300) print 4;
        else print 5;
    }'
}

to_centi() {
    awk -v v="$1" 'BEGIN { printf "%d\n", int((v*100)+0.5) }'
}

append_sample() {
    now=$1; value=$2
    last=0
    if [ -s "$HISTORY_FILE" ]; then
        last=$(tail -n 1 "$HISTORY_FILE" | awk '{print $1+0}')
    fi
    if [ $((now - last)) -ge "$UPDATE_SECONDS" ] || [ "$now" -lt "$last" ]; then
        printf '%s\t%s\n' "$now" "$value" >> "$HISTORY_FILE"
    fi

    cutoff=$((now - ((NOWCAST_HOURS + 2) * 3600)))
    awk -v c="$cutoff" -v n="$now" '$1 >= c && $1 <= n+60' "$HISTORY_FILE" > "$HISTORY_FILE.tmp" && mv -f "$HISTORY_FILE.tmp" "$HISTORY_FILE"
}

calculate_nowcast() {
    now=$1
    awk -v now="$now" -v hours="$NOWCAST_HOURS" -v interval="$UPDATE_SECONDS" \
        -v coverage="$MIN_HOURLY_COVERAGE" -v minrecent="$NOWCAST_MIN_RECENT" \
        -v requirecurrent="$NOWCAST_REQUIRE_CURRENT" '
        function ceil(x) { return (x == int(x)) ? x : int(x)+1 }
        {
            hourstart=int(now/3600)*3600;
            samplehour=int($1/3600)*3600;
            age=int((hourstart-samplehour)/3600);
            if (age >= 0 && age < hours) { sum[age]+=$2; count[age]++ }
        }
        END {
            hourstart=int(now/3600)*3600;
            elapsed=now-hourstart+1;
            for (i=0; i<hours; i++) {
                expected=(i==0) ? int(elapsed/interval)+1 : int(3600/interval);
                if (expected < 1) expected=1;
                needed=ceil(expected*coverage/100);
                if (needed < 1) needed=1;
                if (count[i] >= needed) {
                    avg[i]=sum[i]/count[i]; valid[i]=1;
                    if (!have || avg[i] < min) min=avg[i];
                    if (!have || avg[i] > max) max=avg[i];
                    have=1;
                    if (i < 3) recent++;
                }
            }
            if (!have || recent < minrecent || (requirecurrent=="yes" && !valid[0])) { print "NA"; exit }
            w=(max>0) ? min/max : 1;
            if (w < 0.5) w=0.5;
            if (w > 1) w=1;
            for (i=0; i<hours; i++) if (valid[i]) {
                weight=w^i; numerator+=avg[i]*weight; denominator+=weight;
            }
            if (denominator <= 0) print "NA";
            else printf "%.4f\n", numerator/denominator;
        }
    ' "$HISTORY_FILE"
}

write_status() {
    state=$1; pm=${2:---}; instant=${3:---}; npm=${4:---}; naqi=${5:---}; catcode=${6:---}; detail=${7:-}
    cat > "$STATUS_FILE.tmp" <<EOF
Meteobridge AQI v$VERSION
State: $state
Updated: $(date '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null || date)
PM2.5: $pm ug/m3
Instant AQI: $instant
NowCast PM2.5: $npm ug/m3
NowCast AQI: $naqi
Category code: $catcode
Detail: $detail
EOF
    mv -f "$STATUS_FILE.tmp" "$STATUS_FILE"
}

emit_line() {
    sensor=$1; value=$2
    printf '%s %s\n' "$sensor" "$(to_centi "$value")"
}

emit_status_only() {
    code=$1
    emit_line "$OUTPUT_STATUS" "$code" > "$OUTPUT_FILE.tmp"
    mv -f "$OUTPUT_FILE.tmp" "$OUTPUT_FILE"
    cat "$OUTPUT_FILE"
}

validate_config
mkdir -p "$STATE_DIR" 2>/dev/null || {
    printf '%s 300\n' "$OUTPUT_STATUS"
    echo "meteobridge-aqi: cannot create STATE_DIR: $STATE_DIR" >&2
    exit 1
}

RUN_CONTINUOUS=no
case ${1-} in
    '')
        if [ "$CONFIG_FOUND" != yes ]; then
            while :; do
                emit_line "$OUTPUT_STATUS" 3
                sleep "$UPDATE_SECONDS"
            done
        fi
        # Meteobridge expects data immediately after starting the station.
        # Status 1 means the source has not yet produced a verified sample.
        emit_line "$OUTPUT_STATUS" 1
        RUN_CONTINUOUS=yes
        ;;
    --once)
        if [ "$CONFIG_FOUND" != yes ]; then
            emit_status_only 3
            exit 0
        fi
        ;;
    --help|-h) usage; exit 0 ;;
    --version) echo "$VERSION"; exit 0 ;;
    --show-source)
        echo "PurpleAir URL: $PURPLEAIR_URL"
        echo "PM2.5 source: $PM25_SOURCE (channel A/B average)"
        exit 0
        ;;
    --status) [ -r "$STATUS_FILE" ] && cat "$STATUS_FILE" || echo "No status has been recorded yet."; exit 0 ;;
    --reset-history) : > "$HISTORY_FILE"; rm -f "$OUTPUT_FILE"; echo "NowCast history cleared."; exit 0 ;;
    --sample) : ;;
    *) usage; exit 2 ;;
esac

run_update() (
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    lock_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
    if ! is_uint "$lock_pid" || ! kill -0 "$lock_pid" 2>/dev/null; then
        rm -f "$LOCK_DIR/pid"
        rmdir "$LOCK_DIR" 2>/dev/null || :
        mkdir "$LOCK_DIR" 2>/dev/null || {
            [ -r "$OUTPUT_FILE" ] && cat "$OUTPUT_FILE"
            exit 0
        }
    else
        [ -r "$OUTPUT_FILE" ] && cat "$OUTPUT_FILE"
        exit 0
    fi
fi
printf '%s\n' "$$" > "$LOCK_DIR/pid"
trap 'rm -f "$LOCK_DIR/pid"; rmdir "$LOCK_DIR" 2>/dev/null || :' EXIT HUP INT TERM

now=${AQI_TEST_EPOCH:-$(date +%s)}
sample_mode=no
if [ "${1-}" = "--sample" ]; then
    [ $# -ge 2 ] && [ $# -le 3 ] || { usage; exit 2; }
    raw_pm=$2; pm_age=0; raw_rh=${3:-NA}; rh_age=0; sample_mode=yes
else
    json=$(fetch_json 2>/dev/null) || json=""
    parsed=$(printf '%s\n' "$json" | parse_json 2>/dev/null) || parsed=""
    old_ifs=$IFS; IFS='|'; set -- $parsed; IFS=$old_ifs
    pm_a=${1:-NA}; pm_b=${2:-NA}; raw_rh=${3:-NA}; source_uptime=${4:-NA}; source_period=${5:-NA}
    pm_age=0; rh_age=0

    if is_number "$pm_a" && is_number "$pm_b"; then
        raw_pm=$(awk -v a="$pm_a" -v b="$pm_b" 'BEGIN { printf "%.4f\n", (a+b)/2 }')
        channel_detail="channels A and B averaged"
    elif is_number "$pm_a"; then
        raw_pm=$pm_a
        channel_detail="channel A only; channel B unavailable"
    elif is_number "$pm_b"; then
        raw_pm=$pm_b
        channel_detail="channel B only; channel A unavailable"
    else
        raw_pm=NA
        channel_detail="both particle channels unavailable"
    fi

    # Reject a cached or frozen response if the sensor uptime has not advanced
    # for longer than MAX_SENSOR_AGE. A lower uptime means the sensor rebooted.
    if is_uint "$source_uptime"; then
        last_uptime=""; last_change=$now
        if [ -r "$SOURCE_STAMP_FILE" ]; then
            read -r last_uptime last_change < "$SOURCE_STAMP_FILE" || :
        fi
        if [ "$source_uptime" != "$last_uptime" ]; then
            last_change=$now
        elif ! is_uint "$last_change"; then
            last_change=$now
        fi
        printf '%s %s\n' "$source_uptime" "$last_change" > "$SOURCE_STAMP_FILE.tmp"
        mv -f "$SOURCE_STAMP_FILE.tmp" "$SOURCE_STAMP_FILE"
        if [ $((now - last_change)) -gt "$MAX_SENSOR_AGE" ]; then
            pm_age=$((now - last_change))
        fi
    else
        pm_age=999999
    fi
fi

if ! is_number "$raw_pm" || ! is_uint "$pm_age" || [ "$pm_age" -gt "$MAX_SENSOR_AGE" ]; then
    emit_status_only 1
    write_status "NO DATA" "--" "--" "--" "--" "--" "PurpleAir PM2.5 missing, invalid, or unchanged for more than ${MAX_SENSOR_AGE}s"
    log_msg warn "PurpleAir input rejected (A=${pm_a:-NA} B=${pm_b:-NA} uptime=${source_uptime:-NA} age=$pm_age)"
    exit 0
fi

if awk -v p="$raw_pm" 'BEGIN { exit !(p < 0) }'; then
    emit_status_only 1
    write_status "NO DATA" "--" "--" "--" "--" "--" "negative PM2.5 input rejected"
    log_msg warn "negative PM2.5 input rejected: $raw_pm"
    exit 0
fi

if [ "$PURPLEAIR_CORRECTION" = "epa_us" ]; then
    rh_ok=yes
    is_number "$raw_rh" || rh_ok=no
    is_uint "$rh_age" || rh_ok=no
    [ "$rh_ok" = yes ] && [ "$rh_age" -le "$MAX_SENSOR_AGE" ] || rh_ok=no
    if [ "$rh_ok" = no ]; then
        if [ "$CORRECTION_MISSING_RH" = "reject" ]; then
            emit_status_only 2
            write_status "NO DATA" "--" "--" "--" "--" "--" "EPA correction enabled but RH is missing or stale"
            log_msg warn "EPA correction requires valid RH; sample rejected"
            exit 0
        fi
        corrected_pm=$raw_pm
        log_msg warn "RH unavailable; using uncorrected PM2.5 by configuration"
    else
        corrected_pm=$(apply_correction "$raw_pm" "$raw_rh")
    fi
else
    corrected_pm=$(apply_correction "$raw_pm" 0)
fi

instant_aqi=$(aqi_from_pm "$corrected_pm")
append_sample "$now" "$corrected_pm"

nowcast_pm=NA
nowcast_aqi=NA
if [ "$NOWCAST_ENABLED" = yes ] && [ "$AQI_MODE" != instant ]; then
    nowcast_pm=$(calculate_nowcast "$now")
    if [ "$nowcast_pm" != NA ]; then
        nowcast_aqi=$(aqi_from_pm "$nowcast_pm")
    fi
fi

category_aqi=NA
if [ "$CATEGORY_SOURCE" = instant ]; then
    category_aqi=$instant_aqi
elif [ "$nowcast_aqi" != NA ]; then
    category_aqi=$nowcast_aqi
fi

category_code=NA
[ "$category_aqi" != NA ] && category_code=$(category_from_aqi "$category_aqi")

{
    if [ "$AQI_MODE" = instant ] || [ "$AQI_MODE" = both ]; then emit_line "$OUTPUT_INSTANT_AQI" "$instant_aqi"; fi
    if [ "$AQI_MODE" = nowcast ] || [ "$AQI_MODE" = both ]; then
        [ "$nowcast_aqi" != NA ] && emit_line "$OUTPUT_NOWCAST_AQI" "$nowcast_aqi"
    fi
    [ "$category_code" != NA ] && emit_line "$OUTPUT_CATEGORY" "$category_code"
    emit_line "$OUTPUT_PM25" "$corrected_pm"
    [ "$nowcast_pm" != NA ] && emit_line "$OUTPUT_NOWCAST_PM25" "$nowcast_pm"
    emit_line "$OUTPUT_STATUS" 0
} > "$OUTPUT_FILE.tmp"
mv -f "$OUTPUT_FILE.tmp" "$OUTPUT_FILE"
cat "$OUTPUT_FILE"

detail="valid sample"
[ "$sample_mode" = yes ] || detail="valid sample; $channel_detail; source=$PM25_SOURCE; period=${source_period}s"
[ "$nowcast_aqi" = NA ] && detail="$detail; NowCast waiting for sufficient hourly coverage"
write_status "OK" "$corrected_pm" "$instant_aqi" "$nowcast_pm" "$nowcast_aqi" "$category_code" "$detail"
log_msg debug "pm=$corrected_pm instant_aqi=$instant_aqi nowcast_pm=$nowcast_pm nowcast_aqi=$nowcast_aqi category=$category_code sample_mode=$sample_mode"
exit 0
)

if [ "$RUN_CONTINUOUS" = yes ]; then
    while :; do
        if ! run_update --once; then
            emit_line "$OUTPUT_STATUS" 1
            log_msg error "update cycle ended without data"
        fi
        sleep "$UPDATE_SECONDS"
    done
fi

run_update "$@"
